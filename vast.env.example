# Copy the values from the workshop VM's /config/<team>.config, then save this file as vast.env
# (vast.env is git-ignored. Never commit real values.)

# GPU models (Cosmos3-Reason live reasoning + Canary-1B lecture transcript)
GPU_BEARER_TOKEN=

# VSS archive search for the Sensory map
INGRESS_URL=
USERNAME=
PASSWORD=

# Weights & Biases serverless inference for "What did I miss?"
WANDB_API_KEY=
# Defaults match the VM app; change them only if your key is not in the vastdata team
